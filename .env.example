# Kopia file ida-ne'e ba ".env" no preenxe ho valor real ba ita nia ambiente.
# NUNKA commit ".env" ba git (já iha .gitignore).

# Xave sekretu Django. Jera ida foun ho:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troka-ho-xave-sekretu-foun-ne-ebe-garante-seguransa

# False = produsaun (obrigatóriu). True = dezenvolvimentu deit.
DJANGO_DEBUG=False

# Domeiniu/IP ne'ebé bele asesu site ne'e, hafahe ho vírgula.
# Mis: DJANGO_ALLOWED_HOSTS=matadalaninstitute.tl,www.matadalaninstitute.tl
DJANGO_ALLOWED_HOSTS=

# Orijen ne'ebé konfia ba submissaun POST/CSRF (inklui skema https://).
# Mis: DJANGO_CSRF_TRUSTED_ORIGINS=https://matadalaninstitute.tl,https://www.matadalaninstitute.tl
DJANGO_CSRF_TRUSTED_ORIGINS=

# Redireta automátiku http -> https (dezativa se servidor/proxy ita nian ona trata ida-ne'e)
DJANGO_SECURE_SSL_REDIRECT=True

# Baze dadus MySQL (cPanel). Se DB_NAME mamuk, uza SQLite lokál (dezenvolvimentu).
# Kria database + user iha cPanel -> "MySQL Databases", hafoin "Add User To Database"
# ho ALL PRIVILEGES. Naran sira iha cPanel iha prefiksu konta (mis. mditl2026_).
DB_NAME=mditl2026_simdi
DB_USER=mditl2026_USERNAME
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Fatin file statiku/media. Iha cPanel, hatudu ba public_html atu Apache serve diretamente
# (troka USER ho naran konta cPanel, mis. mditl2026):
# DJANGO_STATIC_ROOT=/home/USER/public_html/static
# DJANGO_MEDIA_ROOT=/home/USER/public_html/media

# Password ba akaun "admin" bainhira hala'o `manage.py seed_data` iha produsaun.
# Se mamuk, sei jera password aleatóriu no hatudu dala ida deit iha output.
# SEED_ADMIN_PASSWORD=

# Email (ba mensajen kontaktu/notifikasaun). Default: haruka ba console (log deit).
# Ba SMTP real, troka DJANGO_EMAIL_BACKEND ba django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@matadalaninstitute.tl

# Cache (opsional) — uza ba limitasaun tentativa login (rate-limit) iha
# config/middleware.py. Se mamuk, sei uza LocMemCache (OK ba 1 worker deit).
# Ba produsaun multi-worker/multi-server (gunicorn -w 3+, load balancer),
# SETE ida-ne'e atu limitasaun partilhadu entre worker/server hotu-hotu:
# Ezemplu Redis: CACHE_URL=redis://127.0.0.1:6379/1
# CACHE_URL=
GA_MEASUREMENT_ID=
